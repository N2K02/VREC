<?xml version="1.0" encoding="utf-8"?>
<!--
    VREC's recording privilege holder. It requests no window content and watches no specific
    app; it only needs to be enabled so the system treats VREC's microphone capture as a
    privileged (accessibility) client during a call. See the in-app Setup screen for why.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_description" />
